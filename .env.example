# ==============================================
# AI Customer Support Automation - ENV EXAMPLE
# ==============================================
# KHÔNG commit file .env thật lên git. Chỉ commit .env.example này.
# Copy thành .env rồi điền giá trị thực.

# ---- App ----
NODE_ENV=development
PORT=3000
# WORKER_PORT dùng cho process worker (mặc định = PORT nếu không set)
WORKER_PORT=3001
API_PREFIX=api
CORS_ORIGIN=http://localhost:3001

# ---- Database (PostgreSQL + pgvector) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_customer_support?schema=public

# ---- Redis (BullMQ) ----
# Nếu để trống các biến REDIS_* thì dùng REDIS_URL (ghép host/port/password/tls).
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ---- JWT / Auth (REQUIRED) ----
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---- Rate limiting ----
THROTTLE_TTL=60
THROTTLE_LIMIT=20

# ---- Logging ----
LOG_LEVEL=info

# ---- File Storage ----
# Chọn 1 trong 2: "local" hoặc "cloudinary"
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# Giới hạn dung lượng file upload (bytes); mặc định 10MB
STORAGE_MAX_UPLOAD_SIZE_BYTES=10485760

# Cloudinary (chỉ dùng khi STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==============================================
# Phase 5 — RAG Pipeline
# ==============================================
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384

CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
RAG_TOP_K_RETRIEVAL=15
RAG_TOP_K_FINAL=5
RAG_EMBEDDING_BATCH_SIZE=16

AI_CONFIDENCE_ESCALATION_THRESHOLD=0.6
SPAM_SCORE_THRESHOLD=0.8

# ---- Telegram channel (Phase 6+) ----
TELEGRAM_BOT_TOKEN=
# true = long-poll getUpdates (local, không cần URL); false = webhook (cần URL public)
TELEGRAM_POLLING_ENABLED=false

# ---- Gmail channel (Phase 6+, Ngày 4) ----
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Gửi mail qua Gmail REST API (port 443, không bị Render free chặn như SMTP).
# Lấy CLIENT_ID/CLIENT_SECRET ở Google Cloud Console; REFRESH_TOKEN lấy qua
# OAuth loopback (chạy node get-gmail-token.js). Nếu để trống thì fallback về SMTP.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
EMAIL_POLLING_ENABLED=false

# ---- Email qua Mailgun (Could have) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support@example.com

# ==============================================
# Phase 8 — Notification Module (Ngày 5)
# ==============================================
# Địa chỉ nhận thông báo Escalation/SLA breach/Document processing failed.
# Có thể dùng chung với SMTP_* ở trên (Gmail App Password cũng dùng được).
ADMIN_NOTIFICATION_EMAIL=admin@example.com
